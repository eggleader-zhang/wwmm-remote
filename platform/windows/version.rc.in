#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/platform/icons/WWMM.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@WWMM_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WWMM Remote"
            VALUE "FileVersion", "@PROJECT_VERSION@.@WWMM_BUILD_NUMBER@"
            VALUE "OriginalFilename", "WWMM Remote.exe"
            VALUE "ProductName", "WWMM Remote"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
